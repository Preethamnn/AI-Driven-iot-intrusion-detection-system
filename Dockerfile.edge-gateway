# Multi-stage Dockerfile for Edge Gateway (Raspberry Pi ARM)
# Stage 1: Build stage
FROM python:3.11-slim-bullseye AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime stage
FROM python:3.11-slim-bullseye

# Create non-root user
RUN groupadd -r idsuser && useradd -r -g idsuser idsuser

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcap0.8 \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /root/.local /home/idsuser/.local

# Copy application code
COPY ai_iot_ids/ /app/ai_iot_ids/
COPY setup.py /app/

# Create necessary directories with proper permissions
RUN mkdir -p /app/data /app/logs /app/config && \
    chown -R idsuser:idsuser /app

# Set Python path
ENV PATH=/home/idsuser/.local/bin:$PATH
ENV PYTHONPATH=/app

# Switch to non-root user
USER idsuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Run edge gateway
CMD ["python", "-m", "ai_iot_ids.edge_gateway_main"]
